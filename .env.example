LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
# Optional; this is the default. The password is read from ~/.pgpass
DATABASE_URL=postgresql://postgres@localhost:5432/primvmon_zoho_vendors
# Optional; source for db/import_saleshub.py (pd-saleshub's local Docker DB)
SALESHUB_DATABASE_URL=postgresql://saleshub_admin:saleshub@localhost:5533/saleshub
# Google Maps key (Geocoding), the one the Search Vendor widget uses
MAPS_API_KEY=your_google_maps_api_key_here
# Read-only login for the chatbot's run_sql tool; written by db/create_readonly_role.py
READONLY_DATABASE_URL=postgresql://vendor_reader:<password>@localhost:5432/primvmon_zoho_vendors
# Optional; this is the default. Driving distances, the same service search_vendor_osrm.php calls
DISTANCE_SERVICE_URL=http://13.58.151.6
